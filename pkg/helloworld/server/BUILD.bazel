load("@rules_go//go:def.bzl", "go_library", "go_test")

# Gateway server: link the gateway proto variant. helloworld_go_proto and
# helloworld_gateway_proto share one importpath, so resolve it explicitly here.
# gazelle:resolve go github.com/esurdam/go-grpc-bazel-example/pb/helloworld //pb/helloworld:helloworld_gateway_proto

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "github.com/esurdam/go-grpc-bazel-example/pkg/helloworld/server",
    visibility = ["//visibility:public"],
    deps = [
        "//pb/helloworld:helloworld_gateway_proto",  # keep
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "server_test",
    srcs = ["server_test.go"],
    deps = [
        ":server",
        "//pb/helloworld:helloworld_gateway_proto",  # keep
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
