module(
    name = "go_grpc_bazel_example",
    version = "0.1.0",
)

# Stay on 0.61.1: rules_go 0.62.0 pulls rules_android toolchains that fail analysis
# on GitHub-hosted Linux runners (CcInfo symbol removed / androidsdk parse error).
bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_proto_grpc_grpc_gateway", version = "5.8.0")

# Pin the grpc-gateway Bazel module to match the Go module version in go.mod,
# keeping the protoc-gen-grpc-gateway codegen in lockstep with the runtime library.
# (rules_proto_grpc_grpc_gateway 5.8.0 otherwise pulls in 2.26.3 transitively.)
# Do not use 2.29.0.bcr.3: it depends on rules_android 0.6.6, which breaks analysis
# on GitHub-hosted runners (CcInfo removed). Stay on plain 2.29.0.
bazel_dep(name = "grpc_ecosystem_grpc_gateway", version = "2.29.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "googleapis", version = "0.0.0-20260728-b8486a2f")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_license", version = "1.0.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# All *direct* Go dependencies of the module have to be listed explicitly.
use_repo(
    go_deps,
    "com_github_philip_bui_grpc_zerolog",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_tools",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    # Pinned by digest for reproducible, supply-chain-safe builds instead of the
    # floating 'latest' tag. This is the multi-platform index digest of
    # gcr.io/distroless/base:latest as of 2026-06 (linux/amd64 + linux/arm64/v8).
    # Re-pin with: docker buildx imagetools inspect gcr.io/distroless/base:latest
    digest = "sha256:f2df8702d4dcc45ce76df6cbc14ad1975fcf88a04bd0e8947b6194264f9ab75e",
    image = "gcr.io/distroless/base",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "distroless_base", "distroless_base_linux_amd64", "distroless_base_linux_arm64_v8")
